# Normalise line endings in the repository; shell heredocs in CI depend on LF.
* text=auto eol=lf

# Windows-native build files keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf

# Binaries.
*.png binary
*.jpg binary
*.ico binary
*.ttf binary
*.otf binary
*.keystore binary
*.jks binary
